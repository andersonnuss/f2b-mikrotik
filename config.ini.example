; Configuracao do f2b-mikrotik  ->  /etc/f2b-mikrotik/config.ini  (chmod 600)
;
; A partir da versao 2.0, roteadores, blacklist, whitelist, intervalos, pais de origem,
; usuarios e auditoria ficam no banco (config_db) e sao editados no PAINEL.
; Aqui fica so o que, por seguranca, nao pode ser alterado pela web: caminhos de comandos
; e arquivos usados como root, e a porta/TLS do proprio painel.

[mikrotik]
; address-list que recebe os IPs (a regra de drop no roteador usa este nome)
address_list = fail2ban
; o agente so altera/remove entradas cujo comentario comeca com este prefixo
comment_prefix = f2b-agent

[fail2ban]
client = /usr/bin/fail2ban-client
; log acompanhado para reagir em segundos. Vazio = so sincronizacao periodica.
logfile = /var/log/fail2ban.log

[agent]
; banco da configuracao editavel pelo painel (roteadores, listas, usuarios, auditoria)
config_db = /var/lib/f2b-mikrotik/config.db
; historico de bloqueios/desbloqueios (contagens e estatisticas)
events_db = /var/lib/f2b-mikrotik/events.db
logfile = /var/log/f2b-mikrotik.log
; DEBUG mostra tambem as sincronizacoes sem alteracao
log_level = INFO
log_max_bytes = 10485760
log_backups = 5
lockfile = /run/f2b-mikrotik.lock

[web]
; painel web (f2b_web.py). Use 127.0.0.1 para aceitar so acessos locais.
bind = 0.0.0.0
port = 8088
; senha INICIAL do usuario admin, usada so na primeira subida (o install.sh gera uma).
; Depois disso os usuarios sao gerenciados no painel (aba Usuarios). Para recuperar o acesso:
;   python3 /opt/f2b-mikrotik/f2b_mikrotik.py --reset-password admin
password =
; HTTPS opcional (recomendado fora da rede interna): caminhos do certificado e da chave
tls_cert =
tls_key =
; tabela de paises (baixada das tabelas publicas dos RIRs)
geo_file = /var/lib/f2b-mikrotik/geo.tsv.gz
